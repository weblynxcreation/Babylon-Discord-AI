# === Discord ===
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token
# Optional during development: sync slash commands immediately to one guild.
# Discord Settings -> Advanced -> Developer Mode, then right-click the server -> Copy Server ID.
DISCORD_GUILD_ID=
# Comma-separated list of Discord user IDs allowed to use admin commands (optional)
DISCORD_ADMIN_IDS=

# === Discord HTTP interactions (required only for the Vercel endpoint) ===
DISCORD_PUBLIC_KEY=
APPLICATION_ID=

# === NVIDIA NIM (LLM brain) ===
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
# Text model with function calling; override with another tool-capable NIM model.
# https://build.nvidia.com/meta/llama-3_3-70b-instruct
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
# Positive seconds. Request retries are disabled; the turn deadline covers all rounds.
NVIDIA_REQUEST_TIMEOUT_SECONDS=45
AGENT_TOOL_TIMEOUT_SECONDS=45
AGENT_TURN_TIMEOUT_SECONDS=120
# NIM-hosted image model
NVIDIA_IMAGE_MODEL=stabilityai/stable-diffusion-3.5-large

# === Web search tool (live internet data) ===
# Get a free key at https://tavily.com — built specifically for LLM agents
TAVILY_API_KEY=replace-with-your-tavily-api-key

# === Optional: fallback image provider if NIM image gen is unavailable ===
STABILITY_API_KEY=

# === Babylon Stock Market (public, read-only commands) ===
BABYLON_API_BASE=https://holdings.thebabylon.hu/api/v1
BABYLON_SITE_BASE=https://holdings.thebabylon.hu
BABYLON_HTTP_TIMEOUT_SECONDS=10
BABYLON_CACHE_SECONDS=30
BABYLON_FRESH_AFTER_MINUTES=60
BABYLON_OUTDATED_AFTER_HOURS=24

# === Capital Rift Obsidian wiki (local, read-only) ===
# Legacy generic name also supported; prefer CAPITAL_RIFT_VAULT_PATH.
OBSIDIAN_VAULT_PATH=
# Use forward slashes on Windows. The bot never writes inside this folder.
CAPITAL_RIFT_VAULT_PATH=C:/replace/with/path/to/Capital Rift Wiki
CAPITAL_RIFT_VAULT_REFRESH_SECONDS=30
CAPITAL_RIFT_MAX_NOTE_BYTES=2097152

# === Bot behavior ===
# Max messages of conversation history to keep per channel
HISTORY_LIMIT=20
# Command prefix for legacy text commands (slash commands work regardless)
COMMAND_PREFIX=!
